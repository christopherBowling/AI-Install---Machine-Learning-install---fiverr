<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Href Wrap URI Generator & Tidy Tool</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .panel h2 {
            color: #4a5568;
            margin-bottom: 20px;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .input-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #4a5568;
        }

        input[type="text"], input[type="url"], textarea, select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        textarea {
            resize: vertical;
            min-height: 120px;
            font-family: 'Courier New', monospace;
        }

        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #718096 0%, #4a5568 100%);
        }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 15px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .checkbox-item input[type="checkbox"] {
            width: auto;
        }

        .output-section {
            grid-column: 1 / -1;
        }

        .output-tabs {
            display: flex;
            margin-bottom: 15px;
            border-bottom: 2px solid #e2e8f0;
        }

        .tab {
            padding: 10px 20px;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: 600;
            color: #718096;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .tab.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }

        .output-content {
            background: #1a202c;
            color: #e2e8f0;
            padding: 20px;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            white-space: pre-wrap;
            word-break: break-all;
            max-height: 300px;
            overflow-y: auto;
        }

        .template-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 10px;
            margin-bottom: 15px;
        }

        .template-btn {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
            border: 2px solid #667eea;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.3s ease;
        }

        .template-btn:hover {
            background: #667eea;
            color: white;
        }

        .status {
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .status.success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: rgba(102, 126, 234, 0.1);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: bold;
            color: #667eea;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #718096;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .header h1 {
                font-size: 2rem;
            }
            .template-grid {
                grid-template-columns: 1fr;
            }
        }

        .icon {
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔗 AI Href Wrap URI Generator</h1>
            <p>Generate, wrap, and tidy HTML links with AI-powered optimization</p>
        </div>

        <div class="main-grid">
            <div class="panel">
                <h2><span class="icon">⚙️</span> Link Generator</h2>
                
                <div class="input-group">
                    <label for="urlInput">URL/URI:</label>
                    <input type="url" id="urlInput" placeholder="https://example.com">
                </div>

                <div class="input-group">
                    <label for="titleInput">Link Text/Title:</label>
                    <input type="text" id="titleInput" placeholder="Visit Example">
                </div>

                <div class="input-group">
                    <label for="classInput">CSS Classes:</label>
                    <input type="text" id="classInput" placeholder="btn primary external">
                </div>

                <div class="input-group">
                    <label for="targetSelect">Target:</label>
                    <select id="targetSelect">
                        <option value="">Same window</option>
                        <option value="_blank">New window/tab</option>
                        <option value="_parent">Parent frame</option>
                        <option value="_top">Full window</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="relInput">Rel Attributes:</label>
                    <input type="text" id="relInput" placeholder="nofollow noopener">
                </div>

                <div class="checkbox-group">
                    <div class="checkbox-item">
                        <input type="checkbox" id="nofollow">
                        <label for="nofollow">Add nofollow</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="noopener">
                        <label for="noopener">Add noopener</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="noreferrer">
                        <label for="noreferrer">Add noreferrer</label>
                    </div>
                </div>

                <button class="btn" onclick="generateLink()">Generate Link</button>
                <button class="btn btn-secondary" onclick="clearFields()">Clear</button>
            </div>

            <div class="panel">
                <h2><span class="icon">🧹</span> Link Tidy & Bulk Process</h2>
                
                <div class="input-group">
                    <label for="bulkInput">Paste HTML/Links to Tidy:</label>
                    <textarea id="bulkInput" placeholder="Paste your HTML links here..."></textarea>
                </div>

                <div class="checkbox-group">
                    <div class="checkbox-item">
                        <input type="checkbox" id="formatCode" checked>
                        <label for="formatCode">Format/Indent</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="addSecurity" checked>
                        <label for="addSecurity">Add Security Attrs</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="validateUrls">
                        <label for="validateUrls">Validate URLs</label>
                    </div>
                </div>

                <button class="btn" onclick="tidyLinks()">Tidy Links</button>
                <button class="btn btn-secondary" onclick="extractUrls()">Extract URLs</button>

                <div class="template-grid" style="margin-top: 20px;">
                    <button class="template-btn" onclick="loadTemplate('social')">Social Media</button>
                    <button class="template-btn" onclick="loadTemplate('navigation')">Navigation</button>
                    <button class="template-btn" onclick="loadTemplate('external')">External Link</button>
                    <button class="template-btn" onclick="loadTemplate('download')">Download Link</button>
                </div>
            </div>

            <div class="panel output-section">
                <h2><span class="icon">📊</span> Statistics & Output</h2>
                
                <div class="stats">
                    <div class="stat-card">
                        <div class="stat-number" id="linkCount">0</div>
                        <div class="stat-label">Links Generated</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="validUrls">0</div>
                        <div class="stat-label">Valid URLs</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="tidiedLinks">0</div>
                        <div class="stat-label">Tidied Links</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="totalChars">0</div>
                        <div class="stat-label">Output Chars</div>
                    </div>
                </div>

                <div id="status"></div>

                <div class="output-tabs">
                    <button class="tab active" onclick="switchTab('html')">HTML Output</button>
                    <button class="tab" onclick="switchTab('preview')">Preview</button>
                    <button class="tab" onclick="switchTab('json')">JSON Data</button>
                </div>

                <div id="htmlOutput" class="output-content"></div>
                <div id="previewOutput" class="output-content" style="display: none; background: white; color: #333;"></div>
                <div id="jsonOutput" class="output-content" style="display: none;"></div>

                <button class="btn" onclick="copyOutput()">Copy Output</button>
                <button class="btn btn-secondary" onclick="downloadOutput()">Download</button>
            </div>
        </div>
    </div>

    <script>
        let generatedLinks = [];
        let activeTab = 'html';

        function generateLink() {
            const url = document.getElementById('urlInput').value.trim();
            const title = document.getElementById('titleInput').value.trim();
            const classes = document.getElementById('classInput').value.trim();
            const target = document.getElementById('targetSelect').value;
            const customRel = document.getElementById('relInput').value.trim();

            if (!url) {
                showStatus('Please enter a URL', 'error');
                return;
            }

            if (!title) {
                showStatus('Please enter link text', 'error');
                return;
            }

            // Build rel attribute
            let rel = [];
            if (customRel) rel.push(customRel);
            if (document.getElementById('nofollow').checked) rel.push('nofollow');
            if (document.getElementById('noopener').checked) rel.push('noopener');
            if (document.getElementById('noreferrer').checked) rel.push('noreferrer');

            // Generate link
            let link = `<a href="${url}"`;
            if (classes) link += ` class="${classes}"`;
            if (target) link += ` target="${target}"`;
            if (rel.length > 0) link += ` rel="${rel.join(' ')}"`;
            link += `>${title}</a>`;

            // Store link data
            const linkData = {
                url, title, classes, target, rel: rel.join(' '), html: link
            };
            generatedLinks.push(linkData);

            updateOutput();
            updateStats();
            showStatus('Link generated successfully!', 'success');
        }

        function tidyLinks() {
            const input = document.getElementById('bulkInput').value.trim();
            if (!input) {
                showStatus('Please paste HTML to tidy', 'error');
                return;
            }

            const formatCode = document.getElementById('formatCode').checked;
            const addSecurity = document.getElementById('addSecurity').checked;
            const validateUrls = document.getElementById('validateUrls').checked;

            // Parse and tidy links
            const parser = new DOMParser();
            const doc = parser.parseFromString(`<div>${input}</div>`, 'text/html');
            const links = doc.querySelectorAll('a');

            let tidiedHtml = '';
            let validUrlCount = 0;

            links.forEach((link, index) => {
                const href = link.href;
                const text = link.textContent;
                
                // Validate URL if requested
                if (validateUrls) {
                    try {
                        new URL(href);
                        validUrlCount++;
                    } catch (e) {
                        link.style.color = 'red';
                        link.title = 'Invalid URL';
                    }
                }

                // Add security attributes if requested
                if (addSecurity && href.startsWith('http') && !href.includes(window.location.hostname)) {
                    link.setAttribute('rel', 'noopener noreferrer');
                    link.setAttribute('target', '_blank');
                }

                // Format the HTML
                const linkHtml = link.outerHTML;
                if (formatCode) {
                    tidiedHtml += `  ${linkHtml}\n`;
                } else {
                    tidiedHtml += linkHtml + '\n';
                }
            });

            // Update bulk input with tidied content
            document.getElementById('bulkInput').value = tidiedHtml;
            
            // Update stats
            document.getElementById('tidiedLinks').textContent = links.length;
            document.getElementById('validUrls').textContent = validUrlCount;

            showStatus(`Tidied ${links.length} links successfully!`, 'success');
            updateOutput();
        }

        function extractUrls() {
            const input = document.getElementById('bulkInput').value.trim();
            if (!input) {
                showStatus('Please paste HTML to extract URLs from', 'error');
                return;
            }

            const parser = new DOMParser();
            const doc = parser.parseFromString(`<div>${input}</div>`, 'text/html');
            const links = doc.querySelectorAll('a');
            
            const urls = Array.from(links).map(link => link.href).filter(href => href);
            
            const urlList = urls.join('\n');
            document.getElementById('bulkInput').value = urlList;
            
            showStatus(`Extracted ${urls.length} URLs`, 'success');
        }

        function loadTemplate(type) {
            const templates = {
                social: {
                    url: 'https://twitter.com/username',
                    title: 'Follow us on Twitter',
                    classes: 'social-link twitter',
                    target: '_blank',
                    rel: 'noopener noreferrer'
                },
                navigation: {
                    url: '/about',
                    title: 'About Us',
                    classes: 'nav-link',
                    target: '',
                    rel: ''
                },
                external: {
                    url: 'https://external-site.com',
                    title: 'Visit External Site',
                    classes: 'external-link',
                    target: '_blank',
                    rel: 'nofollow noopener'
                },
                download: {
                    url: '/files/document.pdf',
                    title: 'Download PDF',
                    classes: 'download-link',
                    target: '_blank',
                    rel: ''
                }
            };

            const template = templates[type];
            if (template) {
                document.getElementById('urlInput').value = template.url;
                document.getElementById('titleInput').value = template.title;
                document.getElementById('classInput').value = template.classes;
                document.getElementById('targetSelect').value = template.target;
                document.getElementById('relInput').value = template.rel;
            }
        }

        function clearFields() {
            document.getElementById('urlInput').value = '';
            document.getElementById('titleInput').value = '';
            document.getElementById('classInput').value = '';
            document.getElementById('targetSelect').value = '';
            document.getElementById('relInput').value = '';
            document.getElementById('nofollow').checked = false;
            document.getElementById('noopener').checked = false;
            document.getElementById('noreferrer').checked = false;
        }

        function updateOutput() {
            const htmlContent = generatedLinks.map(link => link.html).join('\n');
            const previewContent = generatedLinks.map(link => `<p>${link.html}</p>`).join('');
            const jsonContent = JSON.stringify(generatedLinks, null, 2);

            document.getElementById('htmlOutput').textContent = htmlContent;
            document.getElementById('previewOutput').innerHTML = previewContent;
            document.getElementById('jsonOutput').textContent = jsonContent;
        }

        function updateStats() {
            document.getElementById('linkCount').textContent = generatedLinks.length;
            document.getElementById('totalChars').textContent = 
                generatedLinks.reduce((sum, link) => sum + link.html.length, 0);
        }

        function switchTab(tab) {
            // Update active tab
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            // Show/hide content
            document.getElementById('htmlOutput').style.display = tab === 'html' ? 'block' : 'none';
            document.getElementById('previewOutput').style.display = tab === 'preview' ? 'block' : 'none';
            document.getElementById('jsonOutput').style.display = tab === 'json' ? 'block' : 'none';

            activeTab = tab;
        }

        function copyOutput() {
            let content = '';
            if (activeTab === 'html') {
                content = document.getElementById('htmlOutput').textContent;
            } else if (activeTab === 'json') {
                content = document.getElementById('jsonOutput').textContent;
            } else {
                content = document.getElementById('previewOutput').innerHTML;
            }

            navigator.clipboard.writeText(content).then(() => {
                showStatus('Output copied to clipboard!', 'success');
            }).catch(() => {
                showStatus('Failed to copy output', 'error');
            });
        }

        function downloadOutput() {
            let content = '';
            let filename = '';
            let mimeType = '';

            if (activeTab === 'html') {
                content = document.getElementById('htmlOutput').textContent;
                filename = 'generated-links.html';
                mimeType = 'text/html';
            } else if (activeTab === 'json') {
                content = document.getElementById('jsonOutput').textContent;
                filename = 'generated-links.json';
                mimeType = 'application/json';
            } else {
                content = document.getElementById('previewOutput').innerHTML;
                filename = 'generated-links-preview.html';
                mimeType = 'text/html';
            }

            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showStatus('File downloaded successfully!', 'success');
        }

        function showStatus(message, type) {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = message;
            statusDiv.className = `status ${type}`;
            
            setTimeout(() => {
                statusDiv.textContent = '';
                statusDiv.className = '';
            }, 3000);
        }

        // Initialize
        updateStats();
    </script>
</body>
</html>
